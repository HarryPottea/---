{
  "entities": {
    "BoxOffice": {
      "title": "Box Office Data",
      "description": "Daily box office data from KOBIS",
      "type": "object",
      "properties": {
        "date": { "type": "string", "description": "Date of the box office data (YYYYMMDD)" },
        "movies": { "type": "array", "items": { "type": "object" }, "description": "List of movies in the box office" }
      },
      "required": ["date", "movies"]
    },
    "MovieMeta": {
      "title": "Movie Metadata",
      "description": "Metadata for movies",
      "type": "object",
      "properties": {
        "movieNm": { "type": "string", "description": "Movie name" },
        "genre": { "type": "string", "description": "Movie genre" },
        "actors": { "type": "array", "items": { "type": "string" }, "description": "List of actors" }
      },
      "required": ["movieNm"]
    },
    "KeywordTrend": {
      "title": "Keyword Trend",
      "description": "Trend data for keywords from Naver",
      "type": "object",
      "properties": {
        "keyword": { "type": "string", "description": "The keyword" },
        "date": { "type": "string", "description": "Date of the trend data" },
        "ratio": { "type": "number", "description": "Search ratio" }
      },
      "required": ["keyword", "date", "ratio"]
    },
    "RecommendedKeyword": {
      "title": "Recommended Keyword",
      "description": "Keywords recommended based on data analysis",
      "type": "object",
      "properties": {
        "keyword": { "type": "string", "description": "The recommended keyword" },
        "recommendationScore": { "type": "number", "description": "Score of the recommendation" },
        "trendState": { "type": "string", "description": "State of the trend (e.g., 급상승, 상승 중)" },
        "reasonText": { "type": "string", "description": "Reason for the recommendation" },
        "sourceSummary": { "type": "array", "items": { "type": "string" }, "description": "Sources used for the recommendation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update time" }
      },
      "required": ["keyword", "recommendationScore", "trendState", "reasonText", "sourceSummary", "updatedAt"]
    },
    "GeminiInsight": {
      "title": "Gemini Insight",
      "description": "Insights generated by Gemini for specific keywords",
      "type": "object",
      "properties": {
        "keyword": { "type": "string", "description": "The keyword" },
        "insight": { "type": "string", "description": "The generated insight" },
        "urls": { "type": "array", "items": { "type": "object" }, "description": "Grounding URLs" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update time" }
      },
      "required": ["keyword", "insight", "updatedAt"]
    }
  },
  "firestore": {
    "/boxoffice_daily/{date}": {
      "schema": "BoxOffice",
      "description": "Daily box office data"
    },
    "/movie_meta/{movieNm}": {
      "schema": "MovieMeta",
      "description": "Movie metadata"
    },
    "/keyword_trends/{keyword}_{date}": {
      "schema": "KeywordTrend",
      "description": "Keyword trend data"
    },
    "/recommended_keywords/{keyword}": {
      "schema": "RecommendedKeyword",
      "description": "Recommended keywords"
    },
    "/gemini_insights/{keyword}": {
      "schema": "GeminiInsight",
      "description": "Gemini insights"
    }
  }
}
